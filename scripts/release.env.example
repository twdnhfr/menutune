# Einstellungen für scripts/release.sh.
# Kopie ohne .example anlegen; die Datei gehört nicht ins Repository.
# Eine gesetzte Umgebungsvariable hat Vorrang vor dieser Datei.

# Name des notarytool-Schlüsselbund-Profils. Einmalig anlegen mit:
#   xcrun notarytool store-credentials <name> --apple-id <mail> --team-id <TEAMID>
NOTARY_PROFILE=

# Optional. Ohne Angabe wird die erste "Developer ID Application"-Identität
# aus dem Schlüsselbund genommen.
#SIGN_IDENTITY=Developer ID Application: Vorname Nachname (TEAMID)
