# Settings for scripts/release.sh.
# Copy this file without the .example suffix; it stays out of the repository.
# An environment variable of the same name wins over this file.

# Name of the notarytool keychain profile. Create it once with:
#   xcrun notarytool store-credentials <name> --apple-id <mail> --team-id <TEAMID>
NOTARY_PROFILE=

# Optional. Without it the first "Developer ID Application" identity in the
# keychain is used.
#SIGN_IDENTITY=Developer ID Application: Firstname Lastname (TEAMID)
